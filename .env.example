# Variables de entorno de la API
# Copia este archivo como .env y ajusta los valores. Nunca versiones .env.

NODE_ENV=development
PORT=3000

# MySQL 8.0.16+
DATABASE_URL="mysql://root:password@localhost:3306/intranet_college"

# Autenticación
JWT_SECRET="cambia-este-valor-por-uno-largo-y-aleatorio"
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

# CORS: origen del frontend
CORS_ORIGIN=http://localhost:5173

# Archivos del aula virtual
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
