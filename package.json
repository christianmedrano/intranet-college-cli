{
  "name": "intranet-college-cli",
  "description": "Intranet escolar para Inicial, Primaria y Secundaria",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n shared,web,api -c yellow,blue,green \"npm:dev:shared\" \"npm:dev:web\" \"npm:dev:api\"",
    "dev:shared": "tsc -p packages/shared/tsconfig.json --watch --preserveWatchOutput",
    "dev:web": "npm run dev -w @intranet/web",
    "dev:api": "npm run dev -w @intranet/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run build -w @intranet/shared && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:e2e": "playwright test",
    "preview": "npm run preview -w @intranet/web",
    "postinstall": "npm run build -w @intranet/shared"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "playwright": "^1.65.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
