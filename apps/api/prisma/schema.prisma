// Esquema de Prisma del módulo core.
// La cadena de conexión vive en prisma7.config.ts (Prisma 7).
// Fuente de verdad: specs/core/001-spec-mvp/spec.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Identidad: institución, personas, usuarios, roles y sesiones
// ---------------------------------------------------------------------------

/// Institución educativa única por despliegue (RN-CORE-001).
model Institucion {
  id        String  @id @default(uuid()) @db.Char(36)
  nombre    String  @db.VarChar(150)
  direccion String? @db.VarChar(200)
  telefono  String? @db.VarChar(30)
  email     String? @db.VarChar(150)
  logoUrl   String? @map("logo_url") @db.VarChar(500)

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy String?   @map("created_by") @db.Char(36)
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  aniosAcademicos AnioAcademico[]
  niveles         Nivel[]

  @@map("institucion")
}

/// Datos personales comunes a alumnos, docentes y apoderados.
model Persona {
  id              String    @id @default(uuid()) @db.Char(36)
  nombres         String    @db.VarChar(100)
  apellidos       String    @db.VarChar(100)
  tipoDocumento   String    @map("tipo_documento") @db.VarChar(20)
  numeroDocumento String    @map("numero_documento") @db.VarChar(30)
  fechaNacimiento DateTime? @map("fecha_nacimiento") @db.Date
  telefono        String?   @db.VarChar(30)
  emailContacto   String?   @map("email_contacto") @db.VarChar(150)
  direccion       String?   @db.VarChar(200)

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy String?   @map("created_by") @db.Char(36)
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  usuario   Usuario?
  alumno    Alumno?
  docente   Docente?
  apoderado Apoderado?

  @@unique([tipoDocumento, numeroDocumento], map: "persona_documento_key")
  @@map("persona")
}

/// Cuenta de acceso. `username` y `email` son opcionales y únicos si existen
/// (RN-CORE-007). El login también acepta el documento de la persona.
model Usuario {
  id                  String    @id @default(uuid()) @db.Char(36)
  personaId           String    @unique @map("persona_id") @db.Char(36)
  username            String?   @unique @db.VarChar(60)
  email               String?   @unique @db.VarChar(150)
  passwordHash        String    @map("password_hash") @db.VarChar(255)
  debeCambiarPassword Boolean   @default(true) @map("debe_cambiar_password")
  activo              Boolean   @default(true)
  ultimoAcceso        DateTime? @map("ultimo_acceso") @db.DateTime(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy String?   @map("created_by") @db.Char(36)
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  persona            Persona             @relation(fields: [personaId], references: [id], onDelete: Restrict)
  roles              UsuarioRol[]
  sesiones           SesionRefresh[]
  tokensRecuperacion TokenRecuperacion[]
  auditorias         Auditoria[]

  @@map("usuario")
}

/// Catálogo de roles. Los permisos se resuelven en código a partir de `codigo`.
model Rol {
  id          String  @id @default(uuid()) @db.Char(36)
  codigo      String  @unique @db.VarChar(30)
  nombre      String  @db.VarChar(60)
  descripcion String? @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy String?  @map("created_by") @db.Char(36)
  updatedBy String?  @map("updated_by") @db.Char(36)

  usuarios UsuarioRol[]

  @@map("rol")
}

/// Un usuario puede tener varios roles; los permisos se unen (RN-CORE-010).
model UsuarioRol {
  usuarioId String @map("usuario_id") @db.Char(36)
  rolId     String @map("rol_id") @db.Char(36)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  createdBy String?  @map("created_by") @db.Char(36)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Restrict)

  @@id([usuarioId, rolId])
  @@map("usuario_rol")
}

/// Refresh token activo o revocado. Se almacena solo el hash.
model SesionRefresh {
  id         String    @id @default(uuid()) @db.Char(36)
  usuarioId  String    @map("usuario_id") @db.Char(36)
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  expiraEn   DateTime  @map("expira_en") @db.DateTime(3)
  revocadoEn DateTime? @map("revocado_en") @db.DateTime(3)
  ip         String?   @db.VarChar(45)
  userAgent  String?   @map("user_agent") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("sesion_refresh")
}

/// Token de recuperación de un solo uso (RF-CORE-007).
model TokenRecuperacion {
  id        String    @id @default(uuid()) @db.Char(36)
  usuarioId String    @map("usuario_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiraEn  DateTime  @map("expira_en") @db.DateTime(3)
  usadoEn   DateTime? @map("usado_en") @db.DateTime(3)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("token_recuperacion")
}

// ---------------------------------------------------------------------------
// Estructura académica: años, períodos, niveles, grados, secciones y cursos
// ---------------------------------------------------------------------------

/// Año lectivo. Solo uno puede estar ACTIVO (RN-CORE-002): lo garantiza el
/// servicio dentro de una transacción, porque MySQL no tiene índices parciales.
model AnioAcademico {
  id            String   @id @default(uuid()) @db.Char(36)
  institucionId String   @map("institucion_id") @db.Char(36)
  nombre        String   @db.VarChar(20)
  fechaInicio   DateTime @map("fecha_inicio") @db.Date
  fechaFin      DateTime @map("fecha_fin") @db.Date
  /// PLANIFICADO | ACTIVO | CERRADO
  estado        String   @default("PLANIFICADO") @db.VarChar(20)

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy String?   @map("created_by") @db.Char(36)
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  institucion  Institucion         @relation(fields: [institucionId], references: [id], onDelete: Restrict)
  periodos     PeriodoAcademico[]
  secciones    Seccion[]
  matriculas   Matricula[]
  asignaciones AsignacionDocente[]

  @@unique([institucionId, nombre], map: "anio_academico_nombre_key")
  @@index([institucionId, estado])
  @@map("anio_academico")
}

/// Período de evaluación. La cantidad es configurable por año (RN-CORE-003).
model PeriodoAcademico {
  id          String   @id @default(uuid()) @db.Char(36)
  anioId      String   @map("anio_id") @db.Char(36)
  nombre      String   @db.VarChar(50)
  orden       Int
  fechaInicio DateTime @map("fecha_inicio") @db.Date
  fechaFin    DateTime @map("fecha_fin") @db.Date
  /// PLANIFICADO | ACTIVO | CERRADO
  estado      String   @default("PLANIFICADO") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy String?  @map("created_by") @db.Char(36)
  updatedBy String?  @map("updated_by") @db.Char(36)

  anio AnioAcademico @relation(fields: [anioId], references: [id], onDelete: Restrict)

  @@unique([anioId, orden], map: "periodo_academico_orden_key")
  @@unique([anioId, nombre], map: "periodo_academico_nombre_key")
  @@map("periodo_academico")
}

/// Nivel educativo: Inicial, Primaria o Secundaria.
model Nivel {
  id            String @id @default(uuid()) @db.Char(36)
  institucionId String @map("institucion_id") @db.Char(36)
  nombre        String @db.VarChar(50)
  orden         Int

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy String?   @map("created_by") @db.Char(36)
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  institucion Institucion @relation(fields: [institucionId], references: [id], onDelete: Restrict)
  grados      Grado[]
  cursos      Curso[]

  @@unique([institucionId, nombre], map: "nivel_nombre_key")
  @@map("nivel")
}

/// Grado de estudios dentro de un nivel (1.º, 2.º, ...).
model Grado {
  id      String @id @default(uuid()) @db.Char(36)
  nivelId String @map("nivel_id") @db.Char(36)
  nombre  String @db.VarChar(50)
  orden   Int

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy String?   @map("created_by") @db.Char(36)
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  nivel     Nivel     @relation(fields: [nivelId], references: [id], onDelete: Restrict)
  secciones Seccion[]

  @@unique([nivelId, orden], map: "grado_orden_key")
  @@map("grado")
}

/// Sección de un grado en un año lectivo (3.º A).
model Seccion {
  id        String @id @default(uuid()) @db.Char(36)
  gradoId   String @map("grado_id") @db.Char(36)
  anioId    String @map("anio_id") @db.Char(36)
  nombre    String @db.VarChar(20)
  capacidad Int?

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy String?   @map("created_by") @db.Char(36)
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  grado        Grado               @relation(fields: [gradoId], references: [id], onDelete: Restrict)
  anio         AnioAcademico       @relation(fields: [anioId], references: [id], onDelete: Restrict)
  matriculas   Matricula[]
  asignaciones AsignacionDocente[]

  @@unique([gradoId, anioId, nombre], map: "seccion_nombre_key")
  @@index([anioId])
  @@map("seccion")
}

/// Curso o área curricular de un nivel.
model Curso {
  id      String  @id @default(uuid()) @db.Char(36)
  nivelId String  @map("nivel_id") @db.Char(36)
  nombre  String  @db.VarChar(100)
  area    String? @db.VarChar(100)
  orden   Int

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy String?   @map("created_by") @db.Char(36)
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  nivel        Nivel               @relation(fields: [nivelId], references: [id], onDelete: Restrict)
  asignaciones AsignacionDocente[]

  @@unique([nivelId, nombre], map: "curso_nombre_key")
  @@map("curso")
}

// ---------------------------------------------------------------------------
// Personas del ámbito escolar, matrícula y asignaciones
// ---------------------------------------------------------------------------

/// Alumno matriculable. Puede o no tener cuenta de acceso (RF-CORE-012).
model Alumno {
  id            String    @id @default(uuid()) @db.Char(36)
  personaId     String    @unique @map("persona_id") @db.Char(36)
  codigoAlumno  String    @unique @map("codigo_alumno") @db.VarChar(30)
  fechaIngreso  DateTime? @map("fecha_ingreso") @db.Date
  observaciones String?   @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy String?   @map("created_by") @db.Char(36)
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  persona    Persona           @relation(fields: [personaId], references: [id], onDelete: Restrict)
  matriculas Matricula[]
  apoderados ApoderadoAlumno[]

  @@map("alumno")
}

/// Docente. Puede o no tener cuenta de acceso (RF-CORE-013).
model Docente {
  id            String  @id @default(uuid()) @db.Char(36)
  personaId     String  @unique @map("persona_id") @db.Char(36)
  codigoDocente String  @unique @map("codigo_docente") @db.VarChar(30)
  especialidad  String? @db.VarChar(100)

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy String?   @map("created_by") @db.Char(36)
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  persona      Persona             @relation(fields: [personaId], references: [id], onDelete: Restrict)
  asignaciones AsignacionDocente[]

  @@map("docente")
}

/// Apoderado responsable legal de uno o más alumnos (RF-CORE-014).
model Apoderado {
  id        String  @id @default(uuid()) @db.Char(36)
  personaId String  @unique @map("persona_id") @db.Char(36)
  ocupacion String? @db.VarChar(100)

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy String?   @map("created_by") @db.Char(36)
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  persona Persona           @relation(fields: [personaId], references: [id], onDelete: Restrict)
  alumnos ApoderadoAlumno[]

  @@map("apoderado")
}

/// Vínculo apoderado–alumno. Exactamente uno debe ser principal (RN-CORE-008):
/// se valida en el servicio porque MySQL no soporta índices parciales.
model ApoderadoAlumno {
  apoderadoId String  @map("apoderado_id") @db.Char(36)
  alumnoId    String  @map("alumno_id") @db.Char(36)
  parentesco  String  @db.VarChar(50)
  esPrincipal Boolean @default(false) @map("es_principal")

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  createdBy String?  @map("created_by") @db.Char(36)

  apoderado Apoderado @relation(fields: [apoderadoId], references: [id], onDelete: Cascade)
  alumno    Alumno    @relation(fields: [alumnoId], references: [id], onDelete: Cascade)

  @@id([apoderadoId, alumnoId])
  @@index([alumnoId])
  @@map("apoderado_alumno")
}

/// Matrícula de un alumno en una sección para un año lectivo (RF-CORE-015).
model Matricula {
  id             String   @id @default(uuid()) @db.Char(36)
  alumnoId       String   @map("alumno_id") @db.Char(36)
  seccionId      String   @map("seccion_id") @db.Char(36)
  anioId         String   @map("anio_id") @db.Char(36)
  /// SOLICITADA | APROBADA | RETIRADA
  estado         String   @default("SOLICITADA") @db.VarChar(20)
  fechaMatricula DateTime @default(now()) @map("fecha_matricula") @db.DateTime(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy String?   @map("created_by") @db.Char(36)
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  alumno  Alumno        @relation(fields: [alumnoId], references: [id], onDelete: Restrict)
  seccion Seccion       @relation(fields: [seccionId], references: [id], onDelete: Restrict)
  anio    AnioAcademico @relation(fields: [anioId], references: [id], onDelete: Restrict)

  @@unique([alumnoId, anioId], map: "matricula_alumno_anio_key")
  @@index([seccionId])
  @@index([anioId])
  @@map("matricula")
}

/// Asignación de un docente a un curso y sección en un año (RF-CORE-011).
model AsignacionDocente {
  id        String @id @default(uuid()) @db.Char(36)
  docenteId String @map("docente_id") @db.Char(36)
  cursoId   String @map("curso_id") @db.Char(36)
  seccionId String @map("seccion_id") @db.Char(36)
  anioId    String @map("anio_id") @db.Char(36)
  /// Docente tutor de la sección; máximo uno vigente por sección y año.
  esTutor   Boolean @default(false) @map("es_tutor")

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy String?  @map("created_by") @db.Char(36)
  updatedBy String?  @map("updated_by") @db.Char(36)

  docente Docente       @relation(fields: [docenteId], references: [id], onDelete: Restrict)
  curso   Curso         @relation(fields: [cursoId], references: [id], onDelete: Restrict)
  seccion Seccion       @relation(fields: [seccionId], references: [id], onDelete: Restrict)
  anio    AnioAcademico @relation(fields: [anioId], references: [id], onDelete: Restrict)

  @@unique([docenteId, cursoId, seccionId, anioId], map: "asignacion_docente_key")
  @@index([seccionId])
  @@index([anioId])
  @@index([seccionId, anioId, esTutor])
  @@map("asignacion_docente")
}

/// Registro inmutable de operaciones sensibles (RF-CORE-016, RN-CORE-012).
model Auditoria {
  id        String  @id @default(uuid()) @db.Char(36)
  usuarioId String? @map("usuario_id") @db.Char(36)
  accion    String  @db.VarChar(50)
  entidad   String  @db.VarChar(60)
  entidadId String? @map("entidad_id") @db.Char(36)
  datos     Json?
  ip        String? @db.VarChar(45)
  userAgent String? @map("user_agent") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([entidad, entidadId])
  @@index([usuarioId, createdAt])
  @@map("auditoria")
}
