// Esquema de Prisma del módulo core.
// La cadena de conexión vive en prisma7.config.ts (Prisma 7).
// Fuente de verdad: specs/core/001-spec-mvp/spec.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Identidad: institución, personas, usuarios, roles y sesiones
// ---------------------------------------------------------------------------

/// Institución educativa única por despliegue (RN-CORE-001).
model Institucion {
  id        String  @id @default(uuid()) @db.Char(36)
  nombre    String  @db.VarChar(150)
  direccion String? @db.VarChar(200)
  telefono  String? @db.VarChar(30)
  email     String? @db.VarChar(150)
  logoUrl   String? @map("logo_url") @db.VarChar(500)

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy String?   @map("created_by") @db.Char(36)
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  aniosAcademicos AnioAcademico[]
  niveles         Nivel[]
  anuncios        Anuncio[]

  @@map("institucion")
}

/// Datos personales comunes a alumnos, docentes y apoderados.
model Persona {
  id              String    @id @default(uuid()) @db.Char(36)
  nombres         String    @db.VarChar(100)
  apellidos       String    @db.VarChar(100)
  tipoDocumento   String    @map("tipo_documento") @db.VarChar(20)
  numeroDocumento String    @map("numero_documento") @db.VarChar(30)
  fechaNacimiento DateTime? @map("fecha_nacimiento") @db.Date
  telefono        String?   @db.VarChar(30)
  emailContacto   String?   @map("email_contacto") @db.VarChar(150)
  direccion       String?   @db.VarChar(200)

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy String?   @map("created_by") @db.Char(36)
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  usuario   Usuario?
  alumno    Alumno?
  docente   Docente?
  apoderado Apoderado?

  @@unique([tipoDocumento, numeroDocumento], map: "persona_documento_key")
  @@map("persona")
}

/// Cuenta de acceso. `username` y `email` son opcionales y únicos si existen
/// (RN-CORE-007). El login también acepta el documento de la persona.
model Usuario {
  id                  String    @id @default(uuid()) @db.Char(36)
  personaId           String    @unique @map("persona_id") @db.Char(36)
  username            String?   @unique @db.VarChar(60)
  email               String?   @unique @db.VarChar(150)
  passwordHash        String    @map("password_hash") @db.VarChar(255)
  debeCambiarPassword Boolean   @default(true) @map("debe_cambiar_password")
  activo              Boolean   @default(true)
  ultimoAcceso        DateTime? @map("ultimo_acceso") @db.DateTime(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy String?   @map("created_by") @db.Char(36)
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  persona                    Persona              @relation(fields: [personaId], references: [id], onDelete: Restrict)
  roles                      UsuarioRol[]
  sesiones                   SesionRefresh[]
  tokensRecuperacion         TokenRecuperacion[]
  auditorias                 Auditoria[]
  justificacionesSolicitadas JustificacionFalta[] @relation("JustificacionSolicitante")
  justificacionesResueltas   JustificacionFalta[] @relation("JustificacionResolutor")
  anunciosCreados            Anuncio[]            @relation("AnuncioAutor")
  mensajesEnviados           MensajeSeccion[]     @relation("MensajeAutor")

  @@map("usuario")
}

/// Catálogo de roles. Los permisos se resuelven en código a partir de `codigo`.
model Rol {
  id          String  @id @default(uuid()) @db.Char(36)
  codigo      String  @unique @db.VarChar(30)
  nombre      String  @db.VarChar(60)
  descripcion String? @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy String?  @map("created_by") @db.Char(36)
  updatedBy String?  @map("updated_by") @db.Char(36)

  usuarios UsuarioRol[]

  @@map("rol")
}

/// Un usuario puede tener varios roles; los permisos se unen (RN-CORE-010).
model UsuarioRol {
  usuarioId String @map("usuario_id") @db.Char(36)
  rolId     String @map("rol_id") @db.Char(36)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  createdBy String?  @map("created_by") @db.Char(36)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Restrict)

  @@id([usuarioId, rolId])
  @@map("usuario_rol")
}

/// Refresh token activo o revocado. Se almacena solo el hash.
model SesionRefresh {
  id         String    @id @default(uuid()) @db.Char(36)
  usuarioId  String    @map("usuario_id") @db.Char(36)
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  expiraEn   DateTime  @map("expira_en") @db.DateTime(3)
  revocadoEn DateTime? @map("revocado_en") @db.DateTime(3)
  ip         String?   @db.VarChar(45)
  userAgent  String?   @map("user_agent") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("sesion_refresh")
}

/// Token de recuperación de un solo uso (RF-CORE-007).
model TokenRecuperacion {
  id        String    @id @default(uuid()) @db.Char(36)
  usuarioId String    @map("usuario_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiraEn  DateTime  @map("expira_en") @db.DateTime(3)
  usadoEn   DateTime? @map("usado_en") @db.DateTime(3)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("token_recuperacion")
}

// ---------------------------------------------------------------------------
// Estructura académica: años, períodos, niveles, grados, secciones y cursos
// ---------------------------------------------------------------------------

/// Año lectivo. Solo uno puede estar ACTIVO (RN-CORE-002): lo garantiza el
/// servicio dentro de una transacción, porque MySQL no tiene índices parciales.
model AnioAcademico {
  id            String   @id @default(uuid()) @db.Char(36)
  institucionId String   @map("institucion_id") @db.Char(36)
  nombre        String   @db.VarChar(20)
  fechaInicio   DateTime @map("fecha_inicio") @db.Date
  fechaFin      DateTime @map("fecha_fin") @db.Date
  /// PLANIFICADO | ACTIVO | CERRADO
  estado        String   @default("PLANIFICADO") @db.VarChar(20)

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy String?   @map("created_by") @db.Char(36)
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  institucion  Institucion         @relation(fields: [institucionId], references: [id], onDelete: Restrict)
  periodos     PeriodoAcademico[]
  secciones    Seccion[]
  matriculas   Matricula[]
  asignaciones AsignacionDocente[]
  umbral       UmbralAsistencia?
  alertas      AlertaAsistencia[]
  horarios     Horario[]

  @@unique([institucionId, nombre], map: "anio_academico_nombre_key")
  @@index([institucionId, estado])
  @@map("anio_academico")
}

/// Período de evaluación. La cantidad es configurable por año (RN-CORE-003).
model PeriodoAcademico {
  id          String   @id @default(uuid()) @db.Char(36)
  anioId      String   @map("anio_id") @db.Char(36)
  nombre      String   @db.VarChar(50)
  orden       Int
  fechaInicio DateTime @map("fecha_inicio") @db.Date
  fechaFin    DateTime @map("fecha_fin") @db.Date
  /// PLANIFICADO | ACTIVO | CERRADO
  estado      String   @default("PLANIFICADO") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy String?  @map("created_by") @db.Char(36)
  updatedBy String?  @map("updated_by") @db.Char(36)

  anio AnioAcademico @relation(fields: [anioId], references: [id], onDelete: Restrict)

  calificaciones Calificacion[]
  notasFinales   NotaFinalPeriodo[]

  @@unique([anioId, orden], map: "periodo_academico_orden_key")
  @@unique([anioId, nombre], map: "periodo_academico_nombre_key")
  @@map("periodo_academico")
}

/// Nivel educativo: Inicial, Primaria o Secundaria.
model Nivel {
  id            String @id @default(uuid()) @db.Char(36)
  institucionId String @map("institucion_id") @db.Char(36)
  nombre        String @db.VarChar(50)
  orden         Int

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy String?   @map("created_by") @db.Char(36)
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  institucion Institucion @relation(fields: [institucionId], references: [id], onDelete: Restrict)
  grados      Grado[]
  cursos      Curso[]

  @@unique([institucionId, nombre], map: "nivel_nombre_key")
  @@map("nivel")
}

/// Grado de estudios dentro de un nivel (1.º, 2.º, ...).
model Grado {
  id      String @id @default(uuid()) @db.Char(36)
  nivelId String @map("nivel_id") @db.Char(36)
  nombre  String @db.VarChar(50)
  orden   Int

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy String?   @map("created_by") @db.Char(36)
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  nivel     Nivel     @relation(fields: [nivelId], references: [id], onDelete: Restrict)
  secciones Seccion[]

  @@unique([nivelId, orden], map: "grado_orden_key")
  @@map("grado")
}

/// Sección de un grado en un año lectivo (3.º A).
model Seccion {
  id        String @id @default(uuid()) @db.Char(36)
  gradoId   String @map("grado_id") @db.Char(36)
  anioId    String @map("anio_id") @db.Char(36)
  nombre    String @db.VarChar(20)
  capacidad Int?

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy String?   @map("created_by") @db.Char(36)
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  grado        Grado               @relation(fields: [gradoId], references: [id], onDelete: Restrict)
  anio         AnioAcademico       @relation(fields: [anioId], references: [id], onDelete: Restrict)
  matriculas   Matricula[]
  asignaciones AsignacionDocente[]
  horarios     Horario[]
  hiloMensajeria HiloMensajeria?

  @@unique([gradoId, anioId, nombre], map: "seccion_nombre_key")
  @@index([anioId])
  @@map("seccion")
}

/// Curso o área curricular de un nivel.
model Curso {
  id      String  @id @default(uuid()) @db.Char(36)
  nivelId String  @map("nivel_id") @db.Char(36)
  nombre  String  @db.VarChar(100)
  area    String? @db.VarChar(100)
  orden   Int

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy String?   @map("created_by") @db.Char(36)
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  nivel          Nivel               @relation(fields: [nivelId], references: [id], onDelete: Restrict)
  asignaciones   AsignacionDocente[]
  calificaciones Calificacion[]
  notasFinales   NotaFinalPeriodo[]
  horarios       Horario[]

  @@unique([nivelId, nombre], map: "curso_nombre_key")
  @@map("curso")
}

// ---------------------------------------------------------------------------
// Personas del ámbito escolar, matrícula y asignaciones
// ---------------------------------------------------------------------------

/// Alumno matriculable. Puede o no tener cuenta de acceso (RF-CORE-012).
model Alumno {
  id            String    @id @default(uuid()) @db.Char(36)
  personaId     String    @unique @map("persona_id") @db.Char(36)
  codigoAlumno  String    @unique @map("codigo_alumno") @db.VarChar(30)
  fechaIngreso  DateTime? @map("fecha_ingreso") @db.Date
  observaciones String?   @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy String?   @map("created_by") @db.Char(36)
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  persona           Persona            @relation(fields: [personaId], references: [id], onDelete: Restrict)
  matriculas        Matricula[]
  apoderados        ApoderadoAlumno[]
  calificaciones    Calificacion[]
  notasFinales      NotaFinalPeriodo[]
  asistencias       Asistencia[]
  alertasAsistencia AlertaAsistencia[]

  @@map("alumno")
}

/// Docente. Puede o no tener cuenta de acceso (RF-CORE-013).
model Docente {
  id            String  @id @default(uuid()) @db.Char(36)
  personaId     String  @unique @map("persona_id") @db.Char(36)
  codigoDocente String  @unique @map("codigo_docente") @db.VarChar(30)
  especialidad  String? @db.VarChar(100)

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy String?   @map("created_by") @db.Char(36)
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  persona      Persona             @relation(fields: [personaId], references: [id], onDelete: Restrict)
  asignaciones AsignacionDocente[]
  horarios     Horario[]

  @@map("docente")
}

/// Apoderado responsable legal de uno o más alumnos (RF-CORE-014).
model Apoderado {
  id        String  @id @default(uuid()) @db.Char(36)
  personaId String  @unique @map("persona_id") @db.Char(36)
  ocupacion String? @db.VarChar(100)

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy String?   @map("created_by") @db.Char(36)
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  persona Persona           @relation(fields: [personaId], references: [id], onDelete: Restrict)
  alumnos ApoderadoAlumno[]

  @@map("apoderado")
}

/// Vínculo apoderado–alumno. Exactamente uno debe ser principal (RN-CORE-008):
/// se valida en el servicio porque MySQL no soporta índices parciales.
model ApoderadoAlumno {
  apoderadoId String  @map("apoderado_id") @db.Char(36)
  alumnoId    String  @map("alumno_id") @db.Char(36)
  parentesco  String  @db.VarChar(50)
  esPrincipal Boolean @default(false) @map("es_principal")

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  createdBy String?  @map("created_by") @db.Char(36)

  apoderado Apoderado @relation(fields: [apoderadoId], references: [id], onDelete: Cascade)
  alumno    Alumno    @relation(fields: [alumnoId], references: [id], onDelete: Cascade)

  @@id([apoderadoId, alumnoId])
  @@index([alumnoId])
  @@map("apoderado_alumno")
}

/// Matrícula de un alumno en una sección para un año lectivo (RF-CORE-015).
model Matricula {
  id             String   @id @default(uuid()) @db.Char(36)
  alumnoId       String   @map("alumno_id") @db.Char(36)
  seccionId      String   @map("seccion_id") @db.Char(36)
  anioId         String   @map("anio_id") @db.Char(36)
  /// SOLICITADA | APROBADA | RETIRADA
  estado         String   @default("SOLICITADA") @db.VarChar(20)
  fechaMatricula DateTime @default(now()) @map("fecha_matricula") @db.DateTime(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy String?   @map("created_by") @db.Char(36)
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  alumno  Alumno        @relation(fields: [alumnoId], references: [id], onDelete: Restrict)
  seccion Seccion       @relation(fields: [seccionId], references: [id], onDelete: Restrict)
  anio    AnioAcademico @relation(fields: [anioId], references: [id], onDelete: Restrict)

  @@unique([alumnoId, anioId], map: "matricula_alumno_anio_key")
  @@index([seccionId])
  @@index([anioId])
  @@map("matricula")
}

/// Asignación de un docente a un curso y sección en un año (RF-CORE-011).
model AsignacionDocente {
  id        String  @id @default(uuid()) @db.Char(36)
  docenteId String  @map("docente_id") @db.Char(36)
  cursoId   String  @map("curso_id") @db.Char(36)
  seccionId String  @map("seccion_id") @db.Char(36)
  anioId    String  @map("anio_id") @db.Char(36)
  /// Docente tutor de la sección; máximo uno vigente por sección y año.
  esTutor   Boolean @default(false) @map("es_tutor")

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy String?  @map("created_by") @db.Char(36)
  updatedBy String?  @map("updated_by") @db.Char(36)

  docente Docente       @relation(fields: [docenteId], references: [id], onDelete: Restrict)
  curso   Curso         @relation(fields: [cursoId], references: [id], onDelete: Restrict)
  seccion Seccion       @relation(fields: [seccionId], references: [id], onDelete: Restrict)
  anio    AnioAcademico @relation(fields: [anioId], references: [id], onDelete: Restrict)

  @@unique([docenteId, cursoId, seccionId, anioId], map: "asignacion_docente_key")
  @@index([seccionId])
  @@index([anioId])
  @@index([seccionId, anioId, esTutor])
  @@map("asignacion_docente")
}

/// Registro inmutable de operaciones sensibles (RF-CORE-016, RN-CORE-012).
model Auditoria {
  id        String  @id @default(uuid()) @db.Char(36)
  usuarioId String? @map("usuario_id") @db.Char(36)
  accion    String  @db.VarChar(50)
  entidad   String  @db.VarChar(60)
  entidadId String? @map("entidad_id") @db.Char(36)
  datos     Json?
  ip        String? @db.VarChar(45)
  userAgent String? @map("user_agent") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([entidad, entidadId])
  @@index([usuarioId, createdAt])
  @@map("auditoria")
}

// ---------------------------------------------------------------------------
// Módulo académico: calificaciones, asistencias, alertas y horarios
// ---------------------------------------------------------------------------

/// Calificación literal de un alumno en un curso y período (RF-ACAD-001).
/// La escala válida es AD | A | B | C (RN-ACAD-001).
model Calificacion {
  id          String  @id @default(uuid()) @db.Char(36)
  alumnoId    String  @map("alumno_id") @db.Char(36)
  cursoId     String  @map("curso_id") @db.Char(36)
  periodoId   String  @map("periodo_id") @db.Char(36)
  valor       String  @db.Char(2)
  observacion String? @db.VarChar(500)

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy String?   @map("created_by") @db.Char(36)
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  alumno  Alumno           @relation(fields: [alumnoId], references: [id], onDelete: Restrict)
  curso   Curso            @relation(fields: [cursoId], references: [id], onDelete: Restrict)
  periodo PeriodoAcademico @relation(fields: [periodoId], references: [id], onDelete: Restrict)

  @@unique([alumnoId, cursoId, periodoId], map: "calificacion_key")
  @@index([periodoId, cursoId])
  @@map("calificacion")
}

/// Nota final manual del período (RF-ACAD-002). No se calcula ni se deriva de
/// las calificaciones parciales (RN-ACAD-004).
model NotaFinalPeriodo {
  id          String  @id @default(uuid()) @db.Char(36)
  alumnoId    String  @map("alumno_id") @db.Char(36)
  cursoId     String  @map("curso_id") @db.Char(36)
  periodoId   String  @map("periodo_id") @db.Char(36)
  valor       String  @db.Char(2)
  observacion String? @db.VarChar(500)

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy String?   @map("created_by") @db.Char(36)
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  alumno  Alumno           @relation(fields: [alumnoId], references: [id], onDelete: Restrict)
  curso   Curso            @relation(fields: [cursoId], references: [id], onDelete: Restrict)
  periodo PeriodoAcademico @relation(fields: [periodoId], references: [id], onDelete: Restrict)

  @@unique([alumnoId, cursoId, periodoId], map: "nota_final_periodo_key")
  @@index([periodoId, cursoId])
  @@map("nota_final_periodo")
}

/// Asistencia diaria de un alumno; única por alumno y fecha (RN-ACAD-009).
model Asistencia {
  id          String   @id @default(uuid()) @db.Char(36)
  alumnoId    String   @map("alumno_id") @db.Char(36)
  fecha       DateTime @db.Date
  estado      String   @db.VarChar(20)
  observacion String?  @db.VarChar(500)

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy String?   @map("created_by") @db.Char(36)
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  alumno          Alumno               @relation(fields: [alumnoId], references: [id], onDelete: Restrict)
  justificaciones JustificacionFalta[]

  @@unique([alumnoId, fecha], map: "asistencia_key")
  @@index([fecha])
  @@map("asistencia")
}

/// Solicitud de justificación de una falta (RF-ACAD-006). Solo puede haber una
/// `SOLICITADA` por asistencia; se garantiza en el servicio (RN-ACAD-026).
model JustificacionFalta {
  id                   String    @id @default(uuid()) @db.Char(36)
  asistenciaId         String    @map("asistencia_id") @db.Char(36)
  solicitanteUsuarioId String    @map("solicitante_usuario_id") @db.Char(36)
  motivo               String    @db.VarChar(500)
  estado               String    @default("SOLICITADA") @db.VarChar(20)
  resueltoPor          String?   @map("resuelto_por") @db.Char(36)
  resueltoEn           DateTime? @map("resuelto_en") @db.DateTime(3)
  motivoResolucion     String?   @map("motivo_resolucion") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  asistencia  Asistencia @relation(fields: [asistenciaId], references: [id], onDelete: Restrict)
  solicitante Usuario    @relation("JustificacionSolicitante", fields: [solicitanteUsuarioId], references: [id], onDelete: Restrict)
  resolutor   Usuario?   @relation("JustificacionResolutor", fields: [resueltoPor], references: [id], onDelete: Restrict)

  @@index([asistenciaId, estado])
  @@index([estado])
  @@map("justificacion_falta")
}

/// Umbral de inasistencias por año; sin valor por defecto (RN-ACAD-013).
model UmbralAsistencia {
  id               String @id @default(uuid()) @db.Char(36)
  anioId           String @unique @map("anio_id") @db.Char(36)
  faltasParaAlerta Int    @map("faltas_para_alerta")

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy String?  @map("created_by") @db.Char(36)
  updatedBy String?  @map("updated_by") @db.Char(36)

  anio AnioAcademico @relation(fields: [anioId], references: [id], onDelete: Restrict)

  @@map("umbral_asistencia")
}

/// Alerta de inasistencias única por alumno y año (RF-ACAD-009).
model AlertaAsistencia {
  id                   String @id @default(uuid()) @db.Char(36)
  alumnoId             String @map("alumno_id") @db.Char(36)
  anioId               String @map("anio_id") @db.Char(36)
  faltasInjustificadas Int    @map("faltas_injustificadas")
  umbral               Int

  generadaEn    DateTime @default(now()) @map("generada_en") @db.DateTime(3)
  actualizadaEn DateTime @updatedAt @map("actualizada_en") @db.DateTime(3)

  alumno Alumno        @relation(fields: [alumnoId], references: [id], onDelete: Restrict)
  anio   AnioAcademico @relation(fields: [anioId], references: [id], onDelete: Restrict)

  @@unique([alumnoId, anioId], map: "alerta_asistencia_key")
  @@index([anioId])
  @@map("alerta_asistencia")
}

/// Bloque de horario semanal por sección (RF-ACAD-010).
model Horario {
  id         String  @id @default(uuid()) @db.Char(36)
  anioId     String  @map("anio_id") @db.Char(36)
  seccionId  String  @map("seccion_id") @db.Char(36)
  cursoId    String  @map("curso_id") @db.Char(36)
  docenteId  String? @map("docente_id") @db.Char(36)
  diaSemana  Int     @map("dia_semana")
  horaInicio String  @map("hora_inicio") @db.Char(5)
  horaFin    String  @map("hora_fin") @db.Char(5)

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy String?   @map("created_by") @db.Char(36)
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  anio    AnioAcademico @relation(fields: [anioId], references: [id], onDelete: Restrict)
  seccion Seccion       @relation(fields: [seccionId], references: [id], onDelete: Restrict)
  curso   Curso         @relation(fields: [cursoId], references: [id], onDelete: Restrict)
  docente Docente?      @relation(fields: [docenteId], references: [id], onDelete: Restrict)

  @@unique([seccionId, diaSemana, horaInicio], map: "horario_bloque_key")
  @@index([docenteId, diaSemana])
  @@index([anioId, seccionId])
  @@map("horario")
}

// ---------------------------------------------------------------------------
// Módulo de comunicación: anuncios, mensajería y adjuntos
// ---------------------------------------------------------------------------

/// Anuncio institucional o de sección (RF-COM-001, RF-COM-002).
model Anuncio {
  id                  String   @id @default(uuid()) @db.Char(36)
  institucionId       String   @map("institucion_id") @db.Char(36)
  autorId             String   @map("autor_id") @db.Char(36)
  titulo              String   @db.VarChar(200)
  cuerpo              String   @db.Text
  /// INSTITUCIONAL | SECCION
  tipo                String   @db.VarChar(20)
  /// BORRADOR | PUBLICADO | EXPIRADO | ARCHIVADO
  estado              String   @default("BORRADOR") @db.VarChar(20)
  /// Arrays almacenados como JSON (MySQL no soporta arrays de primitivas)
  audienciaNiveles    Json     @default("[]") @map("audiencia_niveles")
  audienciaGrados     Json     @default("[]") @map("audiencia_grados")
  audienciaSecciones  Json     @default("[]") @map("audiencia_secciones")
  audienciaRoles      Json     @default("[]") @map("audiencia_roles")
  publicadoEn         DateTime? @map("publicado_en") @db.DateTime(3)
  expiraEn            DateTime? @map("expira_en") @db.DateTime(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy String?   @map("created_by") @db.Char(36)
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  institucion Institucion       @relation(fields: [institucionId], references: [id], onDelete: Restrict)
  autor       Usuario           @relation("AnuncioAutor", fields: [autorId], references: [id], onDelete: Restrict)
  adjuntos    AdjuntoAnuncio[]

  @@index([institucionId, estado])
  @@index([tipo, estado])
  @@index([publicadoEn])
  @@map("anuncios")
}

/// Adjunto de anuncio (RF-COM-006).
model AdjuntoAnuncio {
  id               String   @id @default(uuid()) @db.Char(36)
  anuncioId        String   @map("anuncio_id") @db.Char(36)
  nombreOriginal   String   @map("nombre_original") @db.VarChar(255)
  nombreAlmacenado String   @map("nombre_almacenado") @db.VarChar(500)
  tipoMime         String   @map("tipo_mime") @db.VarChar(100)
  tamanoBytes      Int      @map("tamano_bytes")

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  anuncio Anuncio @relation(fields: [anuncioId], references: [id], onDelete: Cascade)

  @@map("adjuntos_anuncio")
}

/// Hilo de mensajería por sección (RF-COM-004). Uno por sección.
model HiloMensajeria {
  id        String   @id @default(uuid()) @db.Char(36)
  seccionId String   @unique @map("seccion_id") @db.Char(36)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  seccion  Seccion         @relation(fields: [seccionId], references: [id], onDelete: Restrict)
  mensajes MensajeSeccion[]

  @@map("hilos_mensajeria")
}

/// Mensaje en hilo de sección (RF-COM-004, RF-COM-005).
model MensajeSeccion {
  id        String   @id @default(uuid()) @db.Char(36)
  hiloId    String   @map("hilo_id") @db.Char(36)
  autorId   String   @map("autor_id") @db.Char(36)
  cuerpo    String   @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  hilo      HiloMensajeria   @relation(fields: [hiloId], references: [id], onDelete: Cascade)
  autor     Usuario          @relation("MensajeAutor", fields: [autorId], references: [id], onDelete: Restrict)
  adjuntos  AdjuntoMensaje[]

  @@index([hiloId, createdAt])
  @@map("mensajes_seccion")
}

/// Adjunto de mensaje (RF-COM-006).
model AdjuntoMensaje {
  id               String   @id @default(uuid()) @db.Char(36)
  mensajeId        String   @map("mensaje_id") @db.Char(36)
  nombreOriginal   String   @map("nombre_original") @db.VarChar(255)
  nombreAlmacenado String   @map("nombre_almacenado") @db.VarChar(500)
  tipoMime         String   @map("tipo_mime") @db.VarChar(100)
  tamanoBytes      Int      @map("tamano_bytes")

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  mensaje MensajeSeccion @relation(fields: [mensajeId], references: [id], onDelete: Cascade)

  @@map("adjuntos_mensaje")
}
