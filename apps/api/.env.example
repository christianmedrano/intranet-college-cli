# Variables de entorno de la API
# Copia este archivo como `.env` (mismo directorio). Nunca versiones `.env`.

NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# MySQL 8.0.16+
# Crea la base y un usuario dedicado antes de migrar:
#   CREATE DATABASE intranet_college CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
#   CREATE USER 'intranet_app'@'localhost' IDENTIFIED BY 'TU_CLAVE';
#   GRANT ALL PRIVILEGES ON intranet_college.* TO 'intranet_app'@'localhost';
DATABASE_URL="mysql://intranet_app:TU_CLAVE@localhost:3306/intranet_college"

# Autenticación (mínimo 32 caracteres)
JWT_SECRET="cambia-este-valor-por-uno-largo-y-aleatorio"
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

# Archivos del aula virtual
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Seed de desarrollo (`npm run db:seed`). Nunca en producción.
# SEED_ADMIN_PASSWORD: mínimo 10 caracteres; no puede ser igual al usuario ni al documento.
# El SuperAdmin se crea con `debe_cambiar_password = true`.
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_PASSWORD=cambia-esta-clave-de-desarrollo
SEED_ADMIN_EMAIL=superadmin@ejemplo.edu.pe
